# Telegram Bot
# You can get a token from @BotFather.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Mandatory numeric Telegram ID of the owner / main administrator.
# Replace the value with your ID before launching.
SUPERVISOR_ID=REPLACE_WITH_NUMERIC_TELEGRAM_ID

# Additional administrators and allowlist: positive Telegram IDs separated by commas.
# An empty ALLOWED_USERS means that access is allowed for everyone.
ADMIN_IDS=
ALLOWED_USERS=

# Logging and SQLite
LOG_LEVEL=INFO
DATABASE_PATH=data/bot.db

# Local inference server (OpenAI-compatible API)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300
# Empty: detect from server metadata when available; otherwise set explicitly.
LLM_CONTEXT_SIZE=
# auto: llama.cpp tokenizer when available, otherwise conservative estimate.
# Options: auto, llamacpp, estimate.
LLM_TOKEN_COUNTING=auto
LLM_MAX_CONCURRENT_GENERATIONS=1
MAX_HISTORY_EXCHANGES=1000

# Optional external services.
# Leave URLs empty to disable the corresponding feature.
WHISPER_API_URL=
WHISPER_TIMEOUT=180
DOCUMENT_API_URL=
DOCUMENT_TIMEOUT=300
