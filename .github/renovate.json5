{
  // Renovate (Mend Renovate App) is the only tool that updates dependencies,
  // opens pull requests and merges them. Dependabot stays enabled only for
  // alerts: Renovate reads them to raise security fixes.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "platformCommit": "enabled",
  "dependencyDashboard": { "enabled": true },
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  // A release must be 14 days old before Renovate proposes it.
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "github-actions",
    "pep621",
    "pip-compile",
    "pre-commit"
  ],
  "pre-commit": { "enabled": true },
  // uv wrote the header of requirements-lock.txt, so Renovate regenerates it with uv.
  "pip-compile": { "managerFilePatterns": ["/^requirements-lock\\.txt$/"] },
  // Renovate merges itself after every required check passes.
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  // Whole-lock refreshes would bypass the release age and the human-merge rules.
  "lockFileMaintenance": { "enabled": false },
  // Security fixes skip the schedule and the release age.
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Majors and 0.x releases always wait for a human.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Packages that parse untrusted input or serve the network: only patches are merged automatically.",
      "matchPackageNames": [
        "aiogram",
        "aiohttp",
        "aiosqlite",
        "av",
        "beautifulsoup4",
        "defusedxml",
        "ebooklib",
        "faster-whisper",
        "fastapi",
        "numpy",
        "odfpy",
        "openpyxl",
        "pillow",
        "pydantic",
        "pymupdf",
        "pytesseract",
        "python-docx",
        "python-multipart",
        "python-pptx",
        "starlette",
        "striprtf",
        "uvicorn"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Digest pins carry no release date, so the release age would hold them forever.",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Supported Python versions and the image base change by hand, never by a bot.",
      "matchDatasources": ["docker", "python-version"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "The build backend and packaging tools run while the wheel is built; a human merges them.",
      "matchPackageNames": ["setuptools", "wheel", "build", "packaging"],
      "automerge": false
    },
    {
      "description": "These packages pin each other exactly, so they move in one pull request.",
      "matchPackageNames": ["pydantic", "pydantic-core", "pydantic_core"],
      "groupName": "pydantic"
    },
    {
      "matchPackageNames": ["pymupdf", "pymupdf-layout", "pymupdf4llm"],
      "groupName": "pymupdf"
    },
    {
      "matchPackageNames": ["httpx2", "httpcore2"],
      "groupName": "httpx2"
    },
    {
      "description": "Workflow actions run with the repository token and publish releases; a human merges them.",
      "matchManagers": ["github-actions"],
      "automerge": false,
      "commitMessagePrefix": "ci:",
      "labels": ["dependencies", "github-actions"]
    },
    {
      "matchManagers": ["pep621", "pip-compile"],
      "labels": ["dependencies", "python"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "labels": ["dependencies", "docker"]
    },
    {
      "description": "Hooks execute downloaded code on every contributor machine and in CI; a human merges them.",
      "matchManagers": ["pre-commit"],
      "automerge": false,
      "commitMessagePrefix": "ci:",
      "labels": ["dependencies", "pre-commit"]
    }
  ]
}
