# Telegram bot
# Obtain a token from @BotFather.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Required numeric Telegram ID of the owner / main administrator.
SUPERVISOR_ID=REPLACE_WITH_NUMERIC_TELEGRAM_ID

# Initial administrators and optional static allowlist (comma-separated positive IDs).
ADMIN_IDS=
# An empty ALLOWED_USERS does NOT make the bot public: access remains limited to
# the Supervisor and administrators in SQLite. Set ALLOW_ALL_USERS=true only
# when you intentionally want to allow every non-blocked user.
ALLOWED_USERS=
ALLOW_ALL_USERS=false

# Logging and SQLite
LOG_LEVEL=INFO
DATABASE_PATH=data/bot.db

# OpenAI-compatible LLM server
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300
# Set explicitly if the server does not expose context-length metadata.
LLM_CONTEXT_SIZE=
# auto: probe the optional /tokenize endpoint, then fall back to estimation.
# Options: auto, llamacpp, estimate.
LLM_TOKEN_COUNTING=auto
LLM_MAX_CONCURRENT_GENERATIONS=1
MAX_HISTORY_EXCHANGES=1000
MAX_STORED_EXCHANGES=2000

# Optional audiodoc service. Use the FULL URL including the endpoint path.
# One host:       WHISPER_API_URL=http://127.0.0.1:8000/transcribe
# WireGuard:      WHISPER_API_URL=http://10.8.0.1:8000/transcribe
# HTTPS:          WHISPER_API_URL=https://backend.example.internal/transcribe
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_TIMEOUT=180
DOCUMENT_API_URL=
DOCUMENT_API_KEY=
DOCUMENT_TIMEOUT=300
